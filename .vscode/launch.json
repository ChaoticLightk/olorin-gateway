{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Start All Projects (Blazor + APIs)",
      "configurations": [
        "BlazorApplication",
        "OptimisticApi",
        "PessimisticApi"
      ]
    }
  ],
  "configurations": [
    {
      "name": "BlazorApplication",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "run-blazor",
      "program": "${workspaceFolder}/src/BlazorApplication/bin/Debug/net9.0/BlazorApplication.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/BlazorApplication",
      "stopAtEntry": false
    },
    {
      "name": "OptimisticApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "run-optmistic-api",
      "program": "${workspaceFolder}/src/OptimisticApi/bin/Debug/net9.0/OptimisticApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/OptimisticApi",
      "stopAtEntry": false
    },
    {
      "name": "PessimisticApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "run-pessimistic-api",
      "program": "${workspaceFolder}/src/PessimisticApi/bin/Debug/net9.0/PessimisticApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/PessimisticApi",
      "stopAtEntry": false
    }
  ]
}
