{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-blazor",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/BlazorApplication/BlazorApplication.csproj",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application started"
        }
      }
    },
    {
      "label": "run-optmistic-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/OptimisticApi/OptimisticApi.csproj",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application started"
        }
      }
    },
    {
      "label": "run-pessimistic-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/PessimisticApi/PessimisticApi.csproj",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application started"
        }
      }
    },
    {
      "label": "start-all",
      "dependsOn": [
        "run-blazor",
        "run-optmistic-api",
        "run-pessimistic-api"
      ],
      "problemMatcher": []
    }
  ]
}
