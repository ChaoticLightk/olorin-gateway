{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "Routes": {
      "weatherRoute": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/weatherforecast"
        }
      }
    },
    "Clusters": {
      "apiCluster": {
        "Destinations": {
          "pessimistic": {
            "Address": "https://localhost:7200/"
          },
          "optmistic": {
            "Address": "https://localhost:7100/"
          }
        }
      }
    }
  }
}
